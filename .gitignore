# Zig build artifacts
zig-cache/
.zig-cache/
zig-pkg/
zig-out/
build/

# Path-mangled junk files (absolute paths stripped of separators by buggy tooling).
# Pattern: drive-letter prefix followed by a flattened path, e.g.
#   C:Userstvolodevai-dalatest_type.zig
#   c:Userstvolodevai-dalatest_sb.zig
[Cc]:*
*:Userstvolodevai-*

# Any directory named *.zig-cache (catches mangled absolute-path cache dirs like
# Userstvolodevai-dala.zig-cache in addition to the standard zig-cache above).
*.zig-cache/

# Build output
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
*.dll

# Agent working notes (never committed)
docs/.agent-context/

# Package artifacts
dist/

# Exception: wgpu-native stub archive (empty .lib for linker stub — no real SDK needed for tests)
!vendor/wgpu-native/lib/wgpu_native.lib

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store

# Development tools
.dirlocal
node_modules/

# Test artifacts
*.dwo
*.dwp
testdata/*.png
testresults/*
test-results/

# std.testing.TmpDir artifacts — Zig 0.16 creates these at CWD with random 16+ char names.
# They contain only test_settings.txt, test.log, leak.log, or roll.log from test suites.
# Pattern: 13+ chars of [A-Za-z0-9_-] at the repo root.
# Gitignore does not support regex {} quantifiers — only ? (one char) and * (0+ chars).
# The verbose form below matches any 13+ char alphanumeric/underscore/hyphen name at root.
[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]*
# Dependencies (if vendored)
deps/

# Local configuration
.env
.env.local
*.local

# Temporary files
*.tmp
*.bak
*.orig

# Generated files (if any)
src/generated/

.github/*
CLAUDE.md
.claude/*